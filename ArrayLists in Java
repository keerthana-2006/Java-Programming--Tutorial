public class ArrayListsConcept {
    public static boolean pairSum1Brute(ArrayList<Integer> list,int target)
    {   
        for(int i=0;i<list.size();i++)
        {
                for(int j=i+1;j<list.size();j++)
                {
                    if(list.get(i)+list.get(j)==target)
                        return true;
                
                }
        }
        return false;
    }

    public static boolean pairSum1Pointer(ArrayList<Integer> list,int target)
    {
        int leftPointer=0;
        int rightPointer=list.size()-1;
        while(leftPointer<rightPointer)
        {
            if(list.get(leftPointer)+list.get(rightPointer)==target)
            {
                return true;
            }
            if(list.get(leftPointer)+list.get(rightPointer)>target && list.get(leftPointer)<list.get(rightPointer))
                rightPointer--;
            else
                leftPointer++;
        }
        return false;
    }

    public static boolean pairSum2Pointer(ArrayList<Integer> list,int target)
    {   for(int i=0;i<list.size()-1;i++)
            {
                    if(list.get(i)<list.get(i+1))
                        break;
            }
        int leftPointer=i;
        int rightPointer=i+1;
        int n=list.size();
        while(leftPointer!=rightPointer)
        {
            if(list.get(leftPointer)+list.get(rightPointer)==target)
            {
                return true;
            }
            if(list.get(leftPointer)+list.get(rightPointer)>target)
                rightPointer=(n+rightPointer-1)%n;
            else
                leftPointer=(leftPointer+1)%n;
        }
        return false;
    }
