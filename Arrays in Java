import java.util.Arrays;

public class ArraysDemo {
    public static void main(String[] args) {
        
        // 1. Declaring and Initializing Arrays
        
        // Method 1: Declaration then initialization
        int[] numbers1;
        numbers1 = new int[5];  // Creates array of 5 integers (default 0)
        
        // Method 2: Declaration and initialization together
        int[] numbers2 = new int[5];
        
        // Method 3: Using array literal
        int[] numbers3 = {10, 20, 30, 40, 50};
        
        // Method 4: Using 'new' with values
        int[] numbers4 = new int[]{1, 2, 3, 4, 5};
        
        // 2. Accessing and Modifying Array Elements
        int[] scores = {85, 90, 78, 92, 88};
        System.out.println("First score: " + scores[0]);      // 85
        System.out.println("Third score: " + scores[2]);      // 78
        System.out.println("Array length: " + scores.length); // 5
        
        scores[1] = 95;  // Modify second element
        System.out.println("Modified second score: " + scores[1]);
        
        // 3. Iterating through arrays
        System.out.println("\nIterating with for loop:");
        for (int i = 0; i < scores.length; i++) {
            System.out.print(scores[i] + " ");
        }
        
        System.out.println("\n\nIterating with enhanced for loop:");
        for (int score : scores) {
            System.out.print(score + " ");
        }
        
        // 4. Array utility methods (java.util.Arrays)
        System.out.println("\n\nArray Utilities:");
        int[] arr = {5, 2, 8, 1, 9};
        
        Arrays.sort(arr);  // Sort array
        System.out.println("Sorted: " + Arrays.toString(arr));
        
        int index = Arrays.binarySearch(arr, 8);  // Binary search (array must be sorted)
        System.out.println("Index of 8: " + index);
        
        int[] copyArr = Arrays.copyOf(arr, 3);  // Copy first 3 elements
        System.out.println("Copied array: " + Arrays.toString(copyArr));
        
        int[] rangeCopy = Arrays.copyOfRange(arr, 1, 4);  // Copy index 1 to 3
        System.out.println("Range copy: " + Arrays.toString(rangeCopy));
        
        // Fill array with value
        int[] fillArr = new int[5];
        Arrays.fill(fillArr, 100);
        System.out.println("Filled array: " + Arrays.toString(fillArr));
        
        // Compare arrays
        int[] arr1 = {1, 2, 3};
        int[] arr2 = {1, 2, 3};
        System.out.println("Arrays equal: " + Arrays.equals(arr1, arr2));
        
        // 5. Multi-dimensional Arrays (2D)
        System.out.println("\n2D Arrays:");
        
        // Declaration
        int[][] matrix = new int[3][3];  // 3x3 matrix
        
        // Initialize with values
        int[][] matrix2 = {
            {1, 2, 3},
            {4, 5, 6},
            {7, 8, 9}
        };
        
        // Access elements
        System.out.println("Element at (0,0): " + matrix2[0][0]);  // 1
        System.out.println("Element at (1,2): " + matrix2[1][2]);  // 6
        
        // Iterate 2D array
        System.out.println("\nMatrix:");
        for (int i = 0; i < matrix2.length; i++) {
            for (int j = 0; j < matrix2[i].length; j++) {
                System.out.print(matrix2[i][j] + " ");
            }
            System.out.println();
        }
        
        // Jagged arrays (different row lengths)
        int[][] jagged = new int[3][];
        jagged[0] = new int[]{1, 2};
        jagged[1] = new int[]{3, 4, 5};
        jagged[2] = new int[]{6, 7, 8, 9};
        
        System.out.println("\nJagged Array:");
        for (int i = 0; i < jagged.length; i++) {
            for (int j = 0; j < jagged[i].length; j++) {
                System.out.print(jagged[i][j] + " ");
            }
            System.out.println();
        }
        
        // 6. Array of Objects
        System.out.println("\nArray of Objects:");
        String[] names = new String[3];
        names[0] = "Alice";
        names[1] = "Bob";
        names[2] = "Charlie";
        
        for (String name : names) {
            System.out.println("Name: " + name);
        }
        
        // 7. Command-line arguments (args array)
        // Can be passed when running: java ArraysDemo arg1 arg2 arg3
        System.out.println("\nCommand line arguments:");
        for (String arg : args) {
            System.out.println("Arg: " + arg);
        }
    }
}
