public class CanvasDemo extends Canvas {
    
    public CanvasDemo() {
        setSize(400, 300);
        setBackground(Color.WHITE);
    }
    
    @Override
    public void paint(Graphics g) {
        // Drawing shapes
        g.setColor(Color.RED);
        g.fillRect(50, 50, 100, 80);
        
        g.setColor(Color.BLUE);
        g.fillOval(200, 50, 100, 80);
        
        g.setColor(Color.GREEN);
        g.fillRoundRect(50, 150, 100, 80, 20, 20);
        
        g.setColor(Color.ORANGE);
        g.fillArc(200, 150, 100, 80, 0, 180);
        
        // Drawing text
        g.setColor(Color.BLACK);
        g.setFont(new Font("Arial", Font.BOLD, 16));
        g.drawString("Custom Drawing", 150, 270);
        
        // Drawing lines
        g.setColor(Color.MAGENTA);
        g.drawLine(50, 280, 350, 280);
        
        g.setColor(Color.PINK);
        g.drawRect(50, 50, 100, 80);  // Outline only
    }
    
    public static void main(String[] args) {
        Frame frame = new Frame("Canvas Demo");
        CanvasDemo canvas = new CanvasDemo();
        
        frame.add(canvas);
        frame.setSize(400, 350);
        frame.setVisible(true);
        
        frame.addWindowListener(new WindowAdapter() {
            public void windowClosing(WindowEvent e) {
                System.exit(0);
            }
        });
    }
}
