// Without synchronization - RACE CONDITION
class Counter {
    private int count = 0;
    
    public void increment() {
        count++; // Not atomic - read, modify, write
    }
    
    public int getCount() {
        return count;
    }
}

public class RaceConditionDemo {
    public static void main(String[] args) throws InterruptedException {
        Counter counter = new Counter();
        
        // Create 1000 threads that increment counter
        Thread[] threads = new Thread[1000];
        for (int i = 0; i < 1000; i++) {
            threads[i] = new Thread(() -> {
                for (int j = 0; j < 1000; j++) {
                    counter.increment();
                }
            });
            threads[i].start();
        }
        
        // Wait for all threads
        for (Thread t : threads) {
            t.join();
        }
        
        // Expected: 1,000,000 but actual will be less due to race condition
        System.out.println("Final count (without sync): " + counter.getCount());
        // Output will be different each run, typically less than 1,000,000
    }
}
