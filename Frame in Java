import java.awt.*;
import java.awt.event.*;

public class FrameDemo {
    public static void main(String[] args) {
        // Creating a frame
        Frame frame = new Frame("Frame Demo");
        
        // Setting frame properties
        frame.setSize(500, 400);           // Width x Height
        frame.setLocation(100, 100);       // Position on screen
        frame.setBackground(Color.LIGHT_GRAY);
        frame.setResizable(true);           // Can user resize?
        frame.setTitle("My Application");
        
        // Setting icon (optional - works on some platforms)
        // frame.setIconImage(Toolkit.getDefaultToolkit().getImage("icon.png"));
        
        // Making frame visible
        frame.setVisible(true);
        
        // Closing the frame
        frame.addWindowListener(new WindowAdapter() {
            public void windowClosing(WindowEvent e) {
                frame.dispose();  // Release resources
                System.exit(0);    // Exit application
            }
        });
    }
}
