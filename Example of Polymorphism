// Base class
class Animal {
    protected String name;
    
    public Animal(String name) {
        this.name = name;
    }
    
    // Method to be overridden
    public void makeSound() {
        System.out.println(name + " makes a sound");
    }
    
    public void eat() {
        System.out.println(name + " is eating");
    }
}

// Subclass 1
class Dog extends Animal {
    public Dog(String name) {
        super(name);
    }
    
    @Override
    public void makeSound() {
        System.out.println(name + " barks: Woof! Woof!");
    }
    
    // Dog-specific method
    public void wagTail() {
        System.out.println(name + " is wagging tail");
    }
}

// Subclass 2
class Cat extends Animal {
    public Cat(String name) {
        super(name);
    }
    
    @Override
    public void makeSound() {
        System.out.println(name + " meows: Meow! Meow!");
    }
    
    public void scratch() {
        System.out.println(name + " is scratching");
    }
}

// Subclass 3
class Bird extends Animal {
    public Bird(String name) {
        super(name);
    }
    
    @Override
    public void makeSound() {
        System.out.println(name + " chirps: Chirp! Chirp!");
    }
    
    public void fly() {
        System.out.println(name + " is flying");
    }
}

// Example 2: Method Overloading (Compile-time Polymorphism)
class Calculator {
    // Same method name, different parameters
    public int add(int a, int b) {
        return a + b;
    }
    
    public int add(int a, int b, int c) {
        return a + b + c;
    }
    
    public double add(double a, double b) {
        return a + b;
    }
    
    public String add(String a, String b) {
        return a + b;
    }
}

// Main demonstration
public class PolymorphismDemo {
    public static void main(String[] args) {
        
        // 1. Compile-time Polymorphism (Method Overloading)
        System.out.println("=== Method Overloading ===");
        Calculator calc = new Calculator();
        System.out.println("add(5, 10): " + calc.add(5, 10));
        System.out.println("add(5, 10, 15): " + calc.add(5, 10, 15));
        System.out.println("add(5.5, 10.5): " + calc.add(5.5, 10.5));
        System.out.println("add('Hello', ' World'): " + calc.add("Hello", " World"));
        
        System.out.println("\n" + "=".repeat(50) + "\n");
        
        // 2. Runtime Polymorphism (Method Overriding)
        System.out.println("=== Method Overriding ===");
        
        // Parent reference, child objects
        Animal animal1 = new Dog("Buddy");
        Animal animal2 = new Cat("Whiskers");
        Animal animal3 = new Bird("Tweety");
        
        // Same method call, different behaviors
        animal1.makeSound();  // Calls Dog's version
        animal2.makeSound();  // Calls Cat's version
        animal3.makeSound();  // Calls Bird's version
        
        System.out.println("\n" + "=".repeat(50) + "\n");
        
        // 3. Polymorphic Array
        System.out.println("=== Polymorphic Array ===");
        Animal[] animals = {
            new Dog("Rex"),
            new Cat("Luna"),
            new Bird("Sunny"),
            new Dog("Max"),
            new Cat("Oliver")
        };
        
        for (Animal animal : animals) {
            animal.makeSound();  // Polymorphic call
            animal.eat();        // Inherited method works for all
            System.out.println();  // Blank line
        }
        
        System.out.println("=".repeat(50) + "\n");
        
        // 4. Polymorphic Method Parameter
        System.out.println("=== Polymorphic Parameters ===");
        makeAnimalSound(new Dog("Charlie"));
        makeAnimalSound(new Cat("Simba"));
        makeAnimalSound(new Bird("Polly"));
        
        System.out.println("\n" + "=".repeat(50) + "\n");
        
        // 5. Type Casting with Polymorphism
        System.out.println("=== Type Casting ===");
        Animal myPet = new Dog("Rocky");
        myPet.makeSound();  // Works
        
        // Need to cast to access Dog-specific methods
        if (myPet instanceof Dog) {
            Dog myDog = (Dog) myPet;
            myDog.wagTail();  // Now we can call Dog-specific method
            // myPet.wagTail(); // ERROR: Animal doesn't have wagTail()
        }
        
        // Upcasting (automatic)
        Dog dog = new Dog("Bingo");
        Animal animal = dog;  // Upcasting - always safe
        animal.makeSound();    // Still calls Dog's method
        
        // Downcasting (explicit, need to check type)
        if (animal instanceof Dog) {
            Dog sameDog = (Dog) animal;  // Downcasting
            sameDog.wagTail();
        }
    }
    
    // Method that accepts any Animal type
    public static void makeAnimalSound(Animal animal) {
        System.out.print("Animal says: ");
        animal.makeSound();
    }
}
